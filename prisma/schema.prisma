// Modern Aviation CLT — data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A trip request submitted from the wizard.
///
/// This is the whole customer-facing flow: someone describes the trip, we
/// store it, and an agent replies by email with a price. There is no online
/// quote, booking or account, so everything an agent needs to make that reply
/// has to be captured here.
model FlightRequest {
  id        String @id @default(cuid())
  /// Short human reference an agent can quote over the phone or in email.
  reference String @unique
  status    String @default("new") // new | quoted | closed

  tripType    String // one-way | return | multi-leg
  /// [{ fromIata, fromIcao, fromName, toIata, toIcao, toName, date, time }]
  legs        Json
  flexibility String // exact | 2h | 1d

  passengers    Int
  baggagePieces Int
  oversized     Json // string[] — golf clubs, skis, instrument cases
  pets          Boolean @default(false)
  petInfo       String?

  /// Category slugs the customer picked; empty when they had no preference.
  categories Json
  /// Amenity labels treated as dealbreakers.
  amenities  Json

  name    String
  email   String
  phone   String?
  company String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("flight_requests")
}
